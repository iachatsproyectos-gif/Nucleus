{
  "name": "nucleus",
  "version": "1.0.0",
  "private": true,
  "description": "Nucleus — organizador mental espacial",
  "scripts": {
    "sync:www": "node scripts/sync-www.js",
    "cap:sync": "npm run sync:www && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:apk": "npm run android:build && node scripts/copy-apk.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2"
  }
}
